# Copy to dev/.env (or export in your shell) before running the dev harness / integration tests.
# Points at a throwaway Postgres database; tables are created on boot (push: true).
DATABASE_URI=postgres://user:pass@localhost:5432/webhooks_plugin_test
# Signs deliveries to the local test receiver; the spec defaults to 'test-secret' when unset.
WEBHOOK_SECRET=test-secret
PAYLOAD_SECRET=dev-secret
